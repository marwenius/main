# Calamares: mount.conf

extraMounts:
    - device: proc
      fs: proc
      mountPoint: /proc
    - device: sys
      fs: sysfs
      mountPoint: /sys
    - device: /dev
      mountPoint: /dev
      options: [ bind ]
    - device: tmpfs
      fs: tmpfs
      mountPoint: /run
    - device: /run/udev
      mountPoint: /run/udev
      options: [ bind ]
    - device: efivarfs
      fs: efivarfs
      mountPoint: /sys/firmware/efi/efivars
      efi: true
    - device: /dev/pts
      mountPoint: /dev/pts
      options: [ bind ]
      # /dev/pts is required by apt for storing the logs

btrfsSubvolumes:
    - mountPoint: /
      subvolume: /@
    - mountPoint: /.snapshots
      subvolume: /@snapshots
    - mountPoint: /home
      subvolume: /@home
    - mountPoint: /srv
      subvolume: /@srv
    - mountPoint: /var/log
      subvolume: /@log
    - mountPoint: /var/cache
      subvolume: /@cache
    - mountPoint: /var/tmp
      subvolume: /@tmp
    - mountPoint: /opt
      subvolume: /@opt
    - mountPoint: /var/lib/libvirt
      subvolume: /@libvirt
    - mountPoint: /var/lib/AccountsService
      subvolume: /@AccountsService
    - mountPoint: /var/lib/lightdm
      subvolume: /@lightdm

mountOptions:
    - filesystem: default
      options: [ defaults ]
    - filesystem: efi
      options: [ defaults, umask=0077 ]
    - filesystem: btrfs
      options: [ defaults, noatime, compress-force=zstd:3, discard=async, space_cache=v2 ]
    - filesystem: btrfs_swap
      options: [ defaults, noatime ]

